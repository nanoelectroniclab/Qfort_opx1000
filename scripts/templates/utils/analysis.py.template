    """Process the raw dataset before analysis. TODO: implement."""
    return ds


def fit_raw_data(ds: xr.Dataset, node: QualibrationNode) -> Tuple[xr.Dataset, dict[str, FitParameters]]:
    """Fit the raw data. TODO: implement."""
    fit_results = {q.name: FitParameters(success=False) for q in node.namespace["qubits"]}
    return ds, fit_results
